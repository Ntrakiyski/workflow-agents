DATABASE_URL=postgresql://application:REPLACE_AT_RUNTIME@application-db:5432/application
APPLICATION_ORIGIN=https://workflow-agents.example.com
PORT=8082
# JSON array: username, stable owner_id, SHA256 hex of a strong unique password.
APPLICATION_USERS_JSON=[]
S3_ENDPOINT=http://workflow-files:9000
S3_REGION=us-east-1
S3_BUCKET=workflow-application
S3_ACCESS_KEY_ID=REPLACE_AT_RUNTIME
S3_SECRET_ACCESS_KEY=REPLACE_AT_RUNTIME
RUNNER_URL=http://workflow-phase1-job-runner:8080
RUNNER_TOKEN=REPLACE_AT_RUNTIME
PROVIDER_URL=http://workflow-phase1-sandbox-provider:8000
PROVIDER_TOKEN=REPLACE_AT_RUNTIME
SANDBOX_PROFILE=pi-document-box:v1
WORKLOAD_PROFILE=pi-document-agent:v1
RUNTIME_BUNDLE_OBJECT_KEY=runtime/pi-document-agent/v1/runtime-bundle.tar.gz
RUNTIME_BUNDLE_SHA256=REPLACE_WITH_REVIEWED_ARCHIVE_SHA256
WORKER_INTERVAL_MS=2000
MAX_DURATION_SECONDS=900
