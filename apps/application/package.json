{
  "name": "@workflow-agents/application",
  "version": "0.2.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write src web tests",
    "format:check": "prettier --check src web tests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@fastify/multipart": "10.1.7",
    "fast-xml-parser": "5.12.0",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "yazl": "3.3.1"
  }
}
