{
  "project": {
    "name": "workflow-agents-phase1",
    "description": "Phase 1 reusable infrastructure staging; release gates tracked in Git"
  },
  "environment": "staging",
  "repository": "https://github.com/Ntrakiyski/workflow-agents",
  "branch": "phase1/integration",
  "applications": {
    "job-runner": {
      "base_directory": "/services/job-runner",
      "dockerfile_location": "/Dockerfile",
      "build_pack": "dockerfile",
      "ports_exposes": "8080",
      "domains": "",
      "autogenerate_domain": false,
      "is_auto_deploy_enabled": false,
      "custom_network_aliases": "workflow-phase1-job-runner",
      "custom_docker_run_options": "--cap-drop=ALL --security-opt=no-new-privileges:true --pids-limit=128",
      "health_check_enabled": true,
      "health_check_path": "/health/ready",
      "health_check_port": 8080,
      "limits_cpus": "0.5",
      "limits_memory": "384m",
      "redact_all_env_values_in_logs": false,
      "is_consistent_container_name_enabled": true,
      "custom_internal_name": "workflow-phase1-job-runner",
      "stop_grace_period": 30,
      "profile_file": "deploy/profiles.cloud.staging.json",
      "runtime_environment": {
        "PROVIDER_TIMEOUT_MS": "45000"
      }
    },
    "sandbox-provider": {
      "base_directory": "/services/sandbox-provider",
      "dockerfile_location": "/Dockerfile",
      "build_pack": "dockerfile",
      "ports_exposes": "8000",
      "domains": "",
      "autogenerate_domain": false,
      "is_auto_deploy_enabled": false,
      "custom_network_aliases": "workflow-phase1-sandbox-provider",
      "custom_docker_run_options": "--cap-drop=ALL --security-opt=no-new-privileges:true --pids-limit=256",
      "health_check_enabled": true,
      "health_check_path": "/health/live",
      "health_check_port": 8000,
      "limits_cpus": "1.5",
      "limits_memory": "2048m",
      "storage": {
        "name": "workflow-phase1-boxlite",
        "mount_path": "/var/lib/sandbox-provider"
      },
      "qualification": "Explicit BoxLite Cloud runtime. No local KVM device required. Readiness authenticates to configured Cloud; real HTTP lifecycle/persistence/isolation evidence remains a separate release gate.",
      "is_consistent_container_name_enabled": true,
      "custom_internal_name": "workflow-phase1-sandbox-provider",
      "stop_grace_period": 30,
      "max_restart_count": 3,
      "redact_all_env_values_in_logs": false,
      "profile_file": "deploy/profiles.cloud.staging.json",
      "runtime_environment": {
        "SANDBOX_RUNTIME_MODE": "cloud",
        "BOXLITE_REST_URL": "https://api.boxlite.ai",
        "BOXLITE_ACCOUNT_SCOPE": "workflow-agents-phase1-gcc",
        "RUNTIME_REQUEST_TIMEOUT_SECONDS": "30"
      }
    }
  },
  "databases": {
    "job-runner-db": {
      "type": "postgresql",
      "postgres_user": "job_runner",
      "postgres_db": "job_runner",
      "image": "postgres:16-alpine@sha256:0cefaabd882e42bcb2a2f3dc56d3ce4770560ba62fd7f197f1a2e008fd5731ab",
      "is_public": false,
      "limits_cpus": "0.25",
      "limits_memory": "256m"
    },
    "sandbox-provider-db": {
      "type": "postgresql",
      "postgres_user": "sandbox_provider",
      "postgres_db": "sandbox_provider",
      "image": "postgres:16-alpine@sha256:0cefaabd882e42bcb2a2f3dc56d3ce4770560ba62fd7f197f1a2e008fd5731ab",
      "is_public": false,
      "limits_cpus": "0.25",
      "limits_memory": "256m"
    }
  },
  "policy": {
    "resource_scope": "Only UUIDs returned for this new project may be mutated",
    "secrets": "Generate distinct credentials; use runtime-only Coolify locked environment variables. Never put secret values in this file.",
    "network": "No host port mappings or public domains. Stable aliases on the selected private Docker destination; bearer ownership/profile authorization still required.",
    "deployment": "Pin each application git_commit_sha before deploy. Record returned application/database/deployment UUIDs separately; keep original project untouched.",
    "provider_storage": "One writer only; no rolling overlap of Provider instances sharing BoxLite home. SDK state and disks stay together in the named volume."
  },
  "coolify_url": "https://hosting.gccssofia.com"
}
