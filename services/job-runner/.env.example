# Do not commit .env or real credentials. Use the deployment secret manager.
DATABASE_URL=postgresql://runner_user:replace-me@runner-db:5432/runner
RUNNER_AUTH_JSON=[{"token":"replace-with-random-at-least-32-bytes","actor_id":"fixture-client","owner_id":"fixture-owner","permissions":["job:submit","job:read","job:cancel","schedule:write"],"workload_profiles":["fixture-write-file:v1","fixture-read-file:v1"],"sandbox_profiles":["minimal-linux:v1"],"allow_resume":true}]
# Set this to compact JSON rendered from config/profiles.template.json.
# Template OCI placeholder is deliberately invalid until replaced with verified digest.
RUNNER_PROFILES_JSON=
SANDBOX_PROVIDER_URL=http://sandbox-provider:8080
SANDBOX_PROVIDER_TOKEN=replace-with-private-delegating-provider-token
HOST=0.0.0.0
PORT=8080
QUEUE_CONCURRENCY=2
MAX_GLOBAL_CONCURRENCY=2
MAX_OWNER_CONCURRENCY=1
MAX_PENDING_JOBS=100
MAX_DURATION_SECONDS=3600
MAX_ATTEMPTS=3
PROVIDER_TIMEOUT_MS=5000
POLL_INTERVAL_MS=250
RETRY_BACKOFF_SECONDS=2
# At least QUEUE_CONCURRENCY + 4; reserve connections for API and queue listener.
DB_POOL_SIZE=10
DB_QUERY_TIMEOUT_MS=5000
LOG_LEVEL=info
# Minimum retention policy. No automatic pruning; audit trigger forbids mutation.
AUDIT_RETENTION_DAYS=90
