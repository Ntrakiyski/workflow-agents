{
  "name": "@workflow-agents/job-runner",
  "version": "1.0.0-rc.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "migrate": "tsx src/migrate-cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:unit": "tsx --test tests/unit.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "format:check": "prettier --check src tests scripts",
    "format": "prettier --write src tests scripts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.8",
    "graphile-worker": "0.18.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
