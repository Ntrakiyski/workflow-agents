# Set through the deployment secret manager; never commit populated values.
DATABASE_URL=postgresql://provider:CHANGE_ME@provider-db:5432/provider
PROVIDER_AUTH_JSON=[]
# Render config/profiles.template.json with an approved OCI digest before use.
PROVIDER_PROFILES_JSON={}
BOX_ROOT=/var/lib/sandbox-provider/boxlite
# Explicit runtime choice; cloud never falls back to local execution.
SANDBOX_RUNTIME_MODE=local
# Required only in cloud mode; keep API key in the deployment secret manager.
BOXLITE_REST_URL=https://api.boxlite.ai
BOXLITE_API_KEY=
BOXLITE_ACCOUNT_SCOPE=
# Optional routing prefix, only when supplied by the backend/account.
BOXLITE_REST_PATH_PREFIX=
RUNTIME_REQUEST_TIMEOUT_SECONDS=30
PORT=8000
LOG_LEVEL=INFO
MAX_CONCURRENT_RUNS=4
MAX_SANDBOXES_PER_OWNER=20
MAX_BODY_BYTES=65536
MAX_OUTPUT_BYTES=32768
RUN_POLL_SECONDS=0.25
AUDIT_RETENTION_DAYS=90
