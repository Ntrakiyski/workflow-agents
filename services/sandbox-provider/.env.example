# Set through the deployment secret manager; never commit populated values.
DATABASE_URL=postgresql://provider:CHANGE_ME@provider-db:5432/provider
PROVIDER_AUTH_JSON=[]
# Render config/profiles.template.json with an approved OCI digest before use.
PROVIDER_PROFILES_JSON={}
BOX_ROOT=/var/lib/sandbox-provider/boxlite
PORT=8000
LOG_LEVEL=INFO
MAX_SANDBOXES_PER_OWNER=20
MAX_BODY_BYTES=65536
MAX_OUTPUT_BYTES=32768
RUN_POLL_SECONDS=0.25
AUDIT_RETENTION_DAYS=90
